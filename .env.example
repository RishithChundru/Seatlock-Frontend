# Copy to .env.local for local dev (git-ignored). On Vercel, set them under
# Project -> Settings -> Environment Variables. They are read at build time,
# so redeploy after changing them.
# Where /api/* is proxied (defaults to NEXT_PUBLIC_API_URL)
API_ORIGIN=http://localhost:8080
# Used by the browser only for the live seat-map stream
NEXT_PUBLIC_API_URL=http://localhost:8080
